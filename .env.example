# Backend / Render
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
SESSION_HASH_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=true
CORS_ORIGINS=https://organizadordehorarios.netlify.app,null

# Set these only for the first deployment to create the initial superadmin.
BOOTSTRAP_ADMIN_NAME=Superadmin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-12-character-password

# Frontend / Netlify / Electron build
VITE_API_URL=https://your-backend.onrender.com
